<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %highlight{%5p} %style{%5pid}{magenta} --- %style{[%t]}{bright_green} %notEmpty{%style{[%X{traceId}]}{yellow} }%notEmpty{%style{[%X{spanId}]}{yellow} }%style{%logger}{cyan} : %m%n" disableAnsi="false"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
